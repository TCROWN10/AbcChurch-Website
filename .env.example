# Copy this file to .env.local and fill in the values.
# With nothing set, the site still runs locally: content goes to data/cms.json
# and uploads to data/uploads (fine for trying things out, not for hosting).

# --- Database (PostgreSQL) ---
# On Railway: add a PostgreSQL service, then in the website service's Variables
# set DATABASE_URL=${{Postgres.DATABASE_URL}}. Tables are created automatically.
DATABASE_URL=

# --- Photo & video storage ---
# On Railway: attach a Volume to the website service (mount path e.g. /data).
# Railway sets RAILWAY_VOLUME_MOUNT_PATH and uploads are saved there automatically.
# Elsewhere, point UPLOAD_DIR at any persistent folder.
UPLOAD_DIR=

# --- Optional: Supabase instead of the above ---
# If DATABASE_URL is set it is used for content; Supabase is then only used for file storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Sign-in ---
# Any long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Comma-separated emails that are always super admins.
# If empty, the first account ever created becomes the super admin.
ADMIN_EMAILS=

# --- Online giving (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint pointing to https://YOUR-SITE/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
